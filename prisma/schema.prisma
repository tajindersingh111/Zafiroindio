datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  super_admin
  admin
  manager
  staff
}

enum OrderStatus {
  payment_pending
  paid
  processing
  shipped
  out_for_delivery
  delivered
  payment_failed
  cancelled
  refund_pending
  refunded
  return_requested
  return_approved
  returned
}

enum PaymentStatus {
  pending
  authorized
  captured
  failed
  refunded
}

enum PaymentMethod {
  cod
  razorpay
  upi
  netbanking
  card
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(staff)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("admin_users")
}

model Customer {
  id        String    @id @default(uuid())
  name      String?
  email     String?   @unique
  phone     String    @unique
  status    String    @default("active")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  carts     Cart[]
  wishlists Wishlist[]
  reviews   Review[]
  returns   Return[]

  @@map("customers")
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  name       String
  phone      String
  street     String
  city       String
  state      String
  pincode    String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Collection {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("collections")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  price          Float
  compareAtPrice Float?
  costPrice      Float?
  sku            String?  @unique
  barcode        String?
  stock          Int      @default(0)
  categoryId     String?
  status         String   @default("active")
  isFeatured     Boolean  @default(false)
  tags           String[] @default([])
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  variants           ProductVariant[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  reviews            Review[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  width     Int?
  height    Int?
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  title      String
  sku        String?  @unique
  price      Float
  stock      Int      @default(0)
  attributes Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model InventoryMovement {
  id               String   @id @default(uuid())
  productId        String
  changeQuantity   Int
  previousQuantity Int
  newQuantity      Int
  reason           String
  referenceId      String?
  createdBy        String?
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_movements")
}

model Cart {
  id         String   @id @default(uuid())
  customerId String?
  sessionId  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Wishlist {
  id         String         @id @default(uuid())
  customerId String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  customerId        String?
  status            OrderStatus   @default(payment_pending)
  paymentStatus     PaymentStatus @default(pending)
  paymentMethod     PaymentMethod @default(cod)
  subtotal          Float
  taxTotal          Float         @default(0)
  discountTotal     Float         @default(0)
  shippingFee       Float         @default(0)
  grandTotal        Float
  couponCode        String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  shippingAddress   Json
  billingAddress    Json?
  notes             String?
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  invoices Invoice[]
  shipments Shipment[]
  returns  Return[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  name      String
  sku       String?
  variation String?
  quantity  Int
  price     Float
  tax       Float    @default(0)
  discount  Float    @default(0)
  total     Float
  image     String?
  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  amount            Float
  currency          String        @default("INR")
  gateway           String        @default("razorpay")
  status            PaymentStatus @default(pending)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  rawResponse       Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Coupon {
  id           String    @id @default(uuid())
  code         String    @unique
  discountType String
  value        Float
  minPurchase  Float     @default(0)
  maxDiscount  Float?
  usageLimit   Int?
  usedCount    Int       @default(0)
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("coupons")
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  customerId String
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Return {
  id           String   @id @default(uuid())
  orderId      String
  customerId   String
  status       String   @default("requested")
  reason       String
  refundAmount Float
  items        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("returns")
}

model Shipment {
  id          String    @id @default(uuid())
  orderId     String
  courier     String
  awbCode     String    @unique
  status      String    @default("manifested")
  trackingUrl String?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  orderId       String
  pdfUrl        String?
  amount        Float
  status        String   @default("issued")
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String?
  action      String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model EmailLog {
  id       String   @id @default(uuid())
  toEmail  String
  subject  String
  template String
  status   String   @default("sent")
  error    String?
  sentAt   DateTime @default(now())

  @@map("email_logs")
}

model WebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  provider  String
  eventType String
  payload   Json
  status    String   @default("processed")
  createdAt DateTime @default(now())

  @@map("webhook_events")
}

model OtpRequest {
  id            String   @id @default(uuid())
  phone         String   @unique
  hashedOtp     String
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  expiresAt     DateTime
  cooldownUntil DateTime
  isUsed        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("otp_requests")
}
