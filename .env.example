NODE_ENV="development"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://username:password@localhost:5432/zafiro_indio?schema=public"
# Connections per server instance (keep instances x DB_POOL_MAX below Postgres max_connections)
DB_POOL_MAX="15"
DB_CONNECT_TIMEOUT_MS="10000"

# --- Auth ---
# REQUIRED in production. Generate: openssl rand -base64 48   (min 32 chars)
# Signs admin sessions, shopper (customer) sessions and the login OTP hashes. Changing it signs
# everyone out and invalidates any OTP already sent.
SESSION_SECRET=""
# Public site URL (used for Shiprocket redirect + emails), no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Protects the cron endpoints /api/orders/cleanup-stale (daily) and /api/shipments/sync (every 30-60 min);
# call them with  Authorization: Bearer <value>
CRON_SECRET=""

# --- Payments: Razorpay (own checkout at /checkout) ---
# Dashboard -> Settings -> API Keys. Use rzp_test_* keys until you are ready to take real money.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard -> Settings -> Webhooks. Create a webhook for `payment.captured` and `payment.failed`
# pointing at https://<your-domain>/api/webhooks/razorpay and paste its secret here. Without it the
# webhook returns 503 and only the browser handshake can confirm a payment.
RAZORPAY_WEBHOOK_SECRET=""
# Optional: the publishable key the browser uses. Defaults to RAZORPAY_KEY_ID, which is also public.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Shiprocket Checkout (Fastrr) — legacy, no longer the cart's checkout ---
# Kept so existing Fastrr orders and the catalogue endpoints keep working. Leave blank if unused.
SHIPROCKET_CHECKOUT_API_KEY=""
SHIPROCKET_CHECKOUT_API_SECRET=""
# Secret used to verify Shiprocket's order webhook (falls back to API secret if empty)
SHIPROCKET_CHECKOUT_WEBHOOK_SECRET=""
SHIPROCKET_CHECKOUT_BASE_URL="https://checkout-api.shiprocket.com"
SHIPROCKET_CHECKOUT_TOKEN_PATH="/api/v1/access-token/checkout"
# Leave blank: the official SDK (checkout-ui.shiprocket.com/assets/js/channels/shopify.js) is used.
# The old ".../channels/headless.js" URL returns 404 - do not set it.
NEXT_PUBLIC_SHIPROCKET_CHECKOUT_SDK_URL=""
NEXT_PUBLIC_SHIPROCKET_CHECKOUT_CSS_URL=""

# --- Shipping: ShipMozo (courier booking, AWB, label, pickup, tracking) ---
# Keys from ShipMozo panel -> Settings -> API. Optional here: they can also be saved in Admin -> Shipping
# (environment values win when both are set).
SHIPMOZO_PUBLIC_KEY=""
SHIPMOZO_PRIVATE_KEY=""
# Optional: pickup warehouse id / PIN (default: the warehouse marked default in ShipMozo)
SHIPMOZO_WAREHOUSE_ID=""
SHIPMOZO_PICKUP_PINCODE=""
# Protects /api/webhooks/shipping?token=<value> (ShipMozo status webhook, optional)
SHIPMOZO_WEBHOOK_SECRET=""

# --- Email (SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Zafiro Indio <orders@yourdomain.com>"
