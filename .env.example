NODE_ENV="development"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://username:password@localhost:5432/zafiro_indio?schema=public"

# --- Auth ---
# REQUIRED in production. Generate: openssl rand -base64 48   (min 32 chars)
SESSION_SECRET=""
# Public site URL (used for Shiprocket redirect + emails), no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Protects /api/orders/cleanup-stale (call it from a cron with  Authorization: Bearer <value>)
CRON_SECRET=""

# --- Shiprocket Checkout (Fastrr) ---
SHIPROCKET_CHECKOUT_API_KEY=""
SHIPROCKET_CHECKOUT_API_SECRET=""
# Secret used to verify Shiprocket's order webhook (falls back to API secret if empty)
SHIPROCKET_CHECKOUT_WEBHOOK_SECRET=""
SHIPROCKET_CHECKOUT_BASE_URL="https://checkout-api.shiprocket.com"
# Confirm in your Shiprocket Checkout dashboard docs:
SHIPROCKET_CHECKOUT_TOKEN_PATH="/api/v1/access-token/checkout"
NEXT_PUBLIC_SHIPROCKET_CHECKOUT_SDK_URL=""
NEXT_PUBLIC_SHIPROCKET_CHECKOUT_CSS_URL=""

# --- Shiprocket Shipping (AWB / tracking) ---
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_TRACKING_WEBHOOK_SECRET=""

# --- Email (SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Zafiro Indio <orders@yourdomain.com>"
